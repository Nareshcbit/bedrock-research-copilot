# Copy to .env and fill in. Never commit .env.

AWS_REGION=us-east-1

# Bedrock model invoked by the orchestrator. See STATUS.md for current pin.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# SEC EDGAR requires a descriptive User-Agent (name + contact email).
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT=TODO_NAME TODO_EMAIL

# S3 bucket holding raw filings + chunked artifacts.
S3_BUCKET=TODO_BUCKET_NAME

# OpenSearch Serverless collection endpoint backing the Knowledge Base.
OPENSEARCH_ENDPOINT=TODO_OPENSEARCH_ENDPOINT
